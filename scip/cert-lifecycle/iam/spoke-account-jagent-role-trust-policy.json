{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowSharedServicesJenkinsAgentToAssume",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::<shared-account-id>:role/<jenkins-agent-instance-profile-role>"
      },
      "Action": "sts:AssumeRole"
    }
  ]
}
