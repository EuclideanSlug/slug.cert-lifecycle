__pycache__/
*.pyc
*.pyo
.ansible/

# Terraform
.terraform/
# .terraform.lock.hcl is intentionally NOT ignored so provider version pins are committed.
*.tfstate
*.tfstate.backup
terraform.tfvars
# Environment-specific var files and backend configs in envs/ dirs are operator-created.
# Only .example files are committed.
terraform/*/envs/*.tfvars
terraform/*/envs/*.hcl
override.tf
override.tf.json
*_override.tf
*_override.tf.json
