# Prod shared-services variable file.
# Copy to prod.tfvars and fill in real values before running terraform.
# DO NOT commit prod.tfvars — it may contain account IDs and configuration.
# This .example file may be committed; it contains only placeholders.
#
# Backend config is separate: create envs/prod-backend.hcl (see terraform-deployment.md).
# Apply the prod shared-services root before applying any prod spoke roots.

aws_region = "eu-west-2"
shared_account_id = "<prodc-account-id>"

# ── SNS ───────────────────────────────────────────────────────────────────────

cert_renewal_topic_name  = "scip-cert-renewal"
cert_p1_alert_topic_name = "scip-cert-p1-alerts"

# ── Bitbucket token secret ────────────────────────────────────────────────────

create_bitbucket_token_secret = true
bitbucket_token_secret_name   = "/scip/cert-lifecycle/bitbucket-token"
# bitbucket_token_secret_arn  = "arn:aws:secretsmanager:eu-west-2:<prodc-account-id>:secret:/scip/cert-lifecycle/bitbucket-token-XXXXXX"

# ── Lambda packaging ──────────────────────────────────────────────────────────

lambda_s3_bucket         = "scip-lambda-artefacts-<prod-shared-account-id>"
lambda_s3_key            = "cert-lifecycle/expiry_checker.zip"
lambda_s3_object_version = "<s3-object-version>"

# ── Lambda tuning ─────────────────────────────────────────────────────────────

lambda_function_name       = "scip-cert-expiry-checker"
lambda_execution_role_name = "scip-cert-expiry-checker-role"
lambda_timeout             = 300
lambda_memory_size         = 256
lambda_log_retention_days  = 30

# ── Lambda runtime configuration ──────────────────────────────────────────────
# prod shared-services (deployed into prodc) monitors all prod spoke accounts (prodd–prodj).

catalogue_urls = "https://bitbucket.example.com/projects/SCIP/repos/cert-lifecycle/raw/scip/cert-lifecycle/certs/PT2-prod-certs.yml"

spoke_role_name = "CertLifecycleRole"

spoke_account_ids = [
  "<prodd-account-id>",
  "<prode-account-id>",
  "<prodf-account-id>",
  "<prodg-account-id>",
  "<prodh-account-id>",
  "<prodi-account-id>",
  "<prodj-account-id>",
]

jenkins_job_name = "scip-cert-lifecycle/issue-certificate"
jenkins_job_url  = "https://jenkins.example.com/job/scip-cert-lifecycle/job/issue-certificate"
runbook_url      = "https://confluence.example.com/display/SCIP/cert-lifecycle-runbook"

# ── Tagging ───────────────────────────────────────────────────────────────────

tags = {
  "environment" = "prod"
  "team"        = "platform"
}
