# Example tfvars for the spoke root module.
# Apply this module separately in each spoke account by switching AWS credentials/profile.
# Copy to terraform.tfvars and fill in real values before running terraform plan.
# DO NOT commit terraform.tfvars — it is listed in .gitignore.

aws_region = "eu-west-2"

spoke_account_id = "<spoke-account-id>"

# ── CertLifecycleRole ─────────────────────────────────────────────────────────
# lambda_execution_role_arn comes from the shared-services output:
#   terraform -chdir=../shared-services output lambda_execution_role_arn

spoke_role_name           = "CertLifecycleRole"
lambda_execution_role_arn = "arn:aws:iam::<shared-services-account-id>:role/scip-cert-expiry-checker-role"

# KMS keys used to encrypt certificate secrets in this spoke account.
# Leave empty if not using customer-managed keys.
kms_key_arns = []
# kms_key_arns = ["arn:aws:kms:eu-west-2:<spoke-account-id>:key/<key-id>"]

# ── jagent issuer permissions (optional) ─────────────────────────────────────
# Only enable if this Terraform state owns jagent-ec2-role.
# If jagent-ec2-role is externally managed, apply the policy in
# scip/cert-lifecycle/iam/spoke-account-jagent-policy.json manually.

enable_issuer_permissions = false
jagent_role_name          = "jagent-ec2-role"
jagent_kms_key_arns       = []

# ── Tagging ───────────────────────────────────────────────────────────────────

tags = {
  "environment" = "<dev|preprod|prod>"
  "team"        = "platform"
}
