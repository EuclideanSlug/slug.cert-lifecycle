# Prod prodc spoke variable file.
# Copy to prod-prodc.tfvars and fill in real values before running terraform.
# DO NOT commit prod-prodc.tfvars — it may contain account IDs and configuration.
# This .example file may be committed; it contains only placeholders.
#
# Backend config is separate: create envs/prod-prodc-backend.hcl (see docs/terraform.md).
#
# NOTE: prodc is dual-purpose: it hosts prod shared-services and may also need this
# spoke role for certificates local to prodc. Apply terraform/shared-services with
# ENVIRONMENT=prod into prodc before applying this spoke root.

aws_region = "eu-west-2"

spoke_account_id = "<prodc-account-id>"

# ── CertLifecycleRole ─────────────────────────────────────────────────────────
# lambda_execution_role_arn comes from the prod shared-services (prodc) output:
#   terraform -chdir=terraform/shared-services output lambda_execution_role_arn
# (run with ENVIRONMENT=prod / prodc credentials active)

spoke_role_name           = "CertLifecycleRole"
lambda_execution_role_arn = "arn:aws:iam::<prodc-account-id>:role/slug-cert-expiry-checker-role"

kms_key_arns = []

# ── jagent issuer permissions (optional) ─────────────────────────────────────

enable_issuer_permissions = false
jagent_role_name          = "jagent-ec2-role"
jagent_kms_key_arns       = []

# ── Tagging ───────────────────────────────────────────────────────────────────

tags = {
  "environment" = "prod"
  "account"     = "prodc"
  "team"        = "platform"
}
