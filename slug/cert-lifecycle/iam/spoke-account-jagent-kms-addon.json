{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "KmsForCertSecretsWrite",
      "Effect": "Allow",
      "Action": [
        "kms:GenerateDataKey",
        "kms:Decrypt"
      ],
      "Resource": "arn:aws:kms:eu-west-2:<spoke-account-id>:key/<kms-key-id>",
      "Condition": {
        "StringEquals": {
          "kms:ViaService": "secretsmanager.eu-west-2.amazonaws.com"
        }
      }
    }
  ]
}
