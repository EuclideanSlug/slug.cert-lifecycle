{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadBitbucketToken",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:GetSecretValue"
      ],
      "Resource": "arn:aws:secretsmanager:eu-west-2:<shared-account-id>:secret:/slug/cert-lifecycle/bitbucket-token-*"
    },
    {
      "Sid": "ReadJenkinsTriggerSecret",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:GetSecretValue"
      ],
      "Resource": "arn:aws:secretsmanager:eu-west-2:<shared-account-id>:secret:/slug/cert-lifecycle/jenkins-trigger-*"
    },
    {
      "Sid": "AssumeSpokeCertLifecycleRoles",
      "Effect": "Allow",
      "Action": [
        "sts:AssumeRole"
      ],
      "Resource": [
        "arn:aws:iam::<spoke-account-id-1>:role/CertLifecycleRole",
        "arn:aws:iam::<spoke-account-id-2>:role/CertLifecycleRole"
      ]
    },
    {
      "Sid": "PublishCertificateNotifications",
      "Effect": "Allow",
      "Action": [
        "sns:Publish"
      ],
      "Resource": [
        "arn:aws:sns:eu-west-2:<shared-account-id>:slug-cert-renewal",
        "arn:aws:sns:eu-west-2:<shared-account-id>:slug-cert-p1-alerts"
      ]
    },
    {
      "Sid": "WriteLambdaLogs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": [
        "arn:aws:logs:eu-west-2:<shared-account-id>:log-group:/aws/lambda/slug-cert-expiry-checker",
        "arn:aws:logs:eu-west-2:<shared-account-id>:log-group:/aws/lambda/slug-cert-expiry-checker:*"
      ]
    }
  ]
}
